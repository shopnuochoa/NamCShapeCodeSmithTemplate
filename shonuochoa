<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop Nước Hoa</title>
    <style>
        body { font-family: Arial, sans-serif; text-align: center; margin: 0; padding: 0; }
        header { background: #ff6699; padding: 20px; color: white; font-size: 24px; }
        .container { display: flex; flex-wrap: wrap; justify-content: center; padding: 20px; }
        .product { border: 1px solid #ddd; margin: 10px; padding: 10px; width: 250px; }
        .product img { width: 100%; height: auto; }
        .btn { background: #ff6699; color: white; padding: 10px; border: none; cursor: pointer; }
    </style>
</head>
<body>
    <header>Shop Nước Hoa</header>
    <div class="container">
        <div class="product">
            <img src="https://via.placeholder.com/250" alt="Nước hoa 1">
            <h2>Nước hoa A</h2>
            <p>Giá: 500.000đ</p>
            <button class="btn">Mua ngay</button>
        </div>
        <div class="product">
            <img src="https://via.placeholder.com/250" alt="Nước hoa 2">
            <h2>Nước hoa B</h2>
            <p>Giá: 650.000đ</p>
            <button class="btn">Mua ngay</button>
        </div>
    </div>
</body>
</html>
